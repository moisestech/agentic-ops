FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY services/agent/pyproject.toml /app/services/agent/pyproject.toml
COPY services/agent/src /app/services/agent/src
COPY data /app/data
COPY packages/evals /app/packages/evals

RUN pip install --no-cache-dir -e /app/services/agent

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health')"

CMD ["uvicorn", "agentic_ops.main:app", "--host", "0.0.0.0", "--port", "8080"]
