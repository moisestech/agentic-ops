# Agentic Ops — local development
# Copy to .env. Never commit secrets.

AGENT_HOST=0.0.0.0
AGENT_PORT=8080
AGENT_PUBLIC_URL=http://localhost:8080

# postgres+pgvector (docker compose)
DATABASE_URL=postgresql://ops:ops@localhost:5433/ops

# Provider selection: fake | openai | anthropic | bedrock
AGENT_PROVIDER=fake
DEMO_MODE=1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1

# Web → agent
NEXT_PUBLIC_AGENT_URL=http://localhost:8080
AGENT_CORS_ORIGINS=http://localhost:3000
